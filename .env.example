# Conexion a SQL Server
DB_SERVER=localhost
DB_PORT=1434
DB_DATABASE=mi_base_de_datos
DB_USER=sa
DB_PASSWORD=mi_clave
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Autenticacion:
#   - Deja DB_TRUSTED_CONNECTION vacia (o false) para usar DB_USER/DB_PASSWORD (SQL auth).
#   - Pon DB_TRUSTED_CONNECTION=true para entrar con tu usuario de Windows (sin clave).
#     Con esta opcion DB_USER/DB_PASSWORD se ignoran y se usa msnodesqlv8 (ODBC).
DB_TRUSTED_CONNECTION=

# Opcional: si dejas estas vacias, el programa te pregunta cada vez
# con que tabla y con que columna clave trabajar.
DB_TABLE=
DB_KEY=